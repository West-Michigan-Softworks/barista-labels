PORT=3001
BARISTA_HOST=127.0.0.1
BARISTA_DATA_DIR=./data
# Application storage (independent of the read-only SQL printer catalog below).
BARISTA_STORAGE_BACKEND=sqlite
BARISTA_SQL_SERVER=
BARISTA_SQL_DATABASE=Barista
BARISTA_SQL_PORT=1433
BARISTA_SQL_USER=
BARISTA_SQL_PASSWORD=
BARISTA_SQL_ENCRYPT=true
BARISTA_SQL_TRUST_SERVER_CERTIFICATE=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Set the audience and delegated scope from your separate API registration.
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=
ENTRA_REQUIRED_SCOPE=Labels.Access
# Explicit localhost development only. Never use for LAN deployment.
BARISTA_DEV_AUTH=false
# Dynamic read-only SQL printer catalog. Credentials stay on the Node server.
SQL_PRINTERS_ENABLED=false
SQL_PRINTERS_SERVER=
SQL_PRINTERS_DATABASE=LabelPrint
SQL_PRINTERS_PORT=1433
SQL_PRINTERS_USER=
SQL_PRINTERS_PASSWORD=
SQL_PRINTERS_ENCRYPT=true
SQL_PRINTERS_TRUST_SERVER_CERTIFICATE=false
# dbo.printersZPL does not contain resolution/media information.
# These defaults are an unverified ZT411 203-dpi ZPL profile; calibrate before use.
SQL_PRINTERS_DOTS_PER_MM=8
SQL_PRINTERS_WIDTH_DOTS=832
SQL_PRINTERS_ZPL_PORT=9100
