{
  "name": "barista-labels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "storage:migrate": "node --env-file-if-exists=.env --import tsx tools/migrate-storage.ts",
    "browser:install": "node tools/install-browser.mjs",
    "test:editor-ui": "node tools/editor-ui-audit.mjs",
    "audit:editor-inventory": "node tools/editor-control-inventory.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0",
    "@azure/msal-react": "^3.0.0",
    "@fastify/static": "^10.1.6",
    "@tailwindcss/vite": "^4.0.0",
    "bwip-js": "^4.5.0",
    "daisyui": "^5.0.0",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "jose": "^6.0.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "mssql": "^12.7.4",
    "papaparse": "^5.5.0",
    "playwright": "^1.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
